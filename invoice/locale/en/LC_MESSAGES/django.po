"payment. Allowed statuses are %(allowed_payment)s."
msgstr ""

#: invoice/validation/paymentStatusValidation.py:109
#, python-format
msgid ""
"Invoice %(invoice)s can't be refunded. Invoice has to be in PAYED status, "
"currently it's %(invoice_status)s."
msgstr ""

#: invoice/validation/paymentStatusValidation.py:114
#, python-format
msgid ""
"It's not possible to refund payment %(payment)s, as it's in "
"%(payment_status) status. Only ACCEPTED payments can be refunded."
msgstr ""

#: invoice/validation/paymentStatusValidation.py:123
#, python-format
msgid ""
