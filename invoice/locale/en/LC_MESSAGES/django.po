"currently it's %(invoice_status)s."
msgstr ""

#: invoice/validation/paymentStatusValidation.py:128
#, python-format
msgid ""
"It's not possible to cancel payment %(payment)s, only ACCEPTED payments can "
"be canceled."
msgstr ""

