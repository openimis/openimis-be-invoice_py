#, python-format
msgid ""
"Payment for invoice %(invoice)s can't be made. Invoice has to be in "
"status[%(allowed_invoice)s]. Invoice status is %(invoice_status)s."
msgstr ""

#: invoice/validation/paymentStatusValidation.py:101
#, python-format
msgid ""
